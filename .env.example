# Local development only. Never commit .env.local.
DATABASE_URL=postgresql://agency:agency_local_only@127.0.0.1:5432/agency
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_WITH_NPM_RUN_SETUP_LOCAL
# smtp keeps local messages in Mailpit. Production Resend setup: docs/email-setup.md.
MAIL_PROVIDER=smtp
# Optional: overrides the legacy SMTP_FROM for either provider.
MAIL_FROM=
# Used only with MAIL_PROVIDER=resend. Never use a NEXT_PUBLIC_ variable for this key.
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=website@example.test
NOTIFICATION_EMAIL=owner@example.test
INDEX_SITE=false
# Leave blank locally. On deployment, set only to a header overwritten by a trusted reverse proxy.
TRUSTED_IP_HEADER=
# Optional n8n prospect assistant; leave disabled until configured.
PROSPECT_AUTOMATION_ENABLED=false
PROSPECT_AUTOMATION_TOKEN=
# Optional. POST each new saved enquiry to this n8n webhook.
N8N_ENQUIRY_WEBHOOK_URL=
