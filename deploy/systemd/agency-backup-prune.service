[Unit]
Description=Apply verified agency backup retention
After=postgresql.service network-online.target
Wants=network-online.target
Requires=postgresql.service
ConditionPathExists=/etc/agency/restic.env

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/agency-offsite prune
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agency-backup /var/cache/agency-backup /var/lib/agency-backup-status /var/lib/postgresql/agency-backups
