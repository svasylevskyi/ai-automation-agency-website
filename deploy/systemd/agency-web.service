[Unit]
Description=AI agency website
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=agency
Group=agency
WorkingDirectory=/srv/agency/current
EnvironmentFile=/etc/agency/site.env
EnvironmentFile=/srv/agency/current/release.env
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CacheDirectory=agency
ReadWritePaths=/var/cache/agency

[Install]
WantedBy=multi-user.target
