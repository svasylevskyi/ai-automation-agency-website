# /etc/agency/site.env — root:agency, mode 0640. Never commit the filled file.
NODE_ENV=production
DATABASE_URL=postgresql://agency:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@127.0.0.1:5432/agency
APP_URL=https://agency.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
# Verified SMTP provider; port 587 uses STARTTLS, 465 uses SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=website@agency.example.com
NOTIFICATION_EMAIL=owner@agency.example.com
INDEX_SITE=false
# Only Caddy can reach the application port; Caddy overwrites this header.
TRUSTED_IP_HEADER=x-agency-client-ip
# Optional prospect preparation in n8n. Use a separate random 32-byte token.
PROSPECT_AUTOMATION_ENABLED=false
PROSPECT_AUTOMATION_TOKEN=
