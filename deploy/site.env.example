# /etc/agency/site.env — root:agency, mode 0640. Never commit the filled file.
NODE_ENV=production
DATABASE_URL=postgresql://agency:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@127.0.0.1:5432/agency
APP_URL=https://get-automated.ai
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
# Configure Google Workspace + verify this sending subdomain first: docs/email-setup.md.
# Resend uses HTTPS; SMTP_* settings are not used with this provider.
MAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_A_DOMAIN_RESTRICTED_SENDING_KEY
MAIL_FROM=website@mail.get-automated.ai
NOTIFICATION_EMAIL=hello@get-automated.ai
# In Owner area > Settings set Public email to hello@get-automated.ai for receipt replies.
INDEX_SITE=false
# Only Caddy can reach the application port; Caddy overwrites this header.
TRUSTED_IP_HEADER=x-agency-client-ip
# Optional prospect preparation in n8n. Use a separate random 32-byte token.
PROSPECT_AUTOMATION_ENABLED=false
PROSPECT_AUTOMATION_TOKEN=
# Optional n8n production webhook URL for newly saved enquiries.
N8N_ENQUIRY_WEBHOOK_URL=
