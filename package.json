{
  "name": "ai-automation-agency-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "next start --hostname localhost",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "owner:create": "node --env-file-if-exists=.env.local --import tsx scripts/owner.ts",
    "maintenance": "node --env-file-if-exists=.env.local --import tsx scripts/maintenance.ts"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.7.5",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
